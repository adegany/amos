{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amos.local/schemas/cognitive_workspace.schema.json",
  "title": "AMOS generated cognitive workspace",
  "type": "object",
  "required": [
    "status",
    "profile",
    "schema_version",
    "workspace_id",
    "revision",
    "current_event",
    "temporal_context",
    "thread_heads",
    "available_new_thread_aliases",
    "protected_refs",
    "omissions",
    "budget"
  ],
  "properties": {
    "status": { "const": "compiled" },
    "profile": { "const": "amos.cognitive-workspace.v1" },
    "schema_version": { "const": "amos.v1" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "revision": {
      "type": "object",
      "required": ["graph_version", "journal_head"]
    },
    "current_event": { "type": "object" },
    "temporal_context": { "type": "array", "items": { "type": "object" } },
    "thread_heads": { "type": "array", "items": { "type": "object" } },
    "canonical_context": {
      "type": "array",
      "items": { "type": "object" }
    },
    "available_new_thread_aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "associative_memory": { "type": ["object", "null"] },
    "page_aliases": {
      "type": "array",
      "items": { "type": "object" }
    },
    "bound_refs": { "type": "object" },
    "protected_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "omissions": { "type": "array", "items": { "type": "object" } },
    "budget": {
      "type": "object",
      "required": ["limit_bytes", "used_bytes", "estimated_tokens"]
    }
  },
  "additionalProperties": true
}
