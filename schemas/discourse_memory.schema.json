{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amos.local/schemas/discourse_memory.schema.json",
  "title": "AMOS generic interaction and discourse memory profiles",
  "$defs": {
    "StateEntry": {
      "type": "object",
      "required": ["key", "value", "basis_refs"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": {},
        "basis_refs": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "UnresolvedItem": {
      "type": "object",
      "required": ["kind", "description", "basis_refs"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "basis_refs": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "InteractionEvent": {
      "type": "object",
      "required": [
        "profile",
        "conversation_id",
        "sequence",
        "actor_ref",
        "role",
        "content",
        "occurred_at",
        "visibility",
        "source_ref"
      ],
      "properties": {
        "profile": { "const": "amos.interaction-event.v1" },
        "conversation_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "actor_ref": { "type": "string", "minLength": 1 },
        "role": { "enum": ["human", "agent", "system", "tool"] },
        "content": { "type": "string" },
        "occurred_at": { "type": "string", "minLength": 1 },
        "in_reply_to": { "type": ["string", "null"] },
        "visibility": { "enum": ["shared", "private"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "thread_refs": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "DiscourseThread": {
      "type": "object",
      "required": [
        "profile",
        "thread_id",
        "conversation_id",
        "opened_by_event_ref",
        "participants"
      ],
      "properties": {
        "profile": { "const": "amos.discourse-thread.v1" },
        "thread_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 },
        "opened_by_event_ref": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "DiscourseState": {
      "type": "object",
      "required": [
        "profile",
        "thread_id",
        "revision",
        "lifecycle",
        "attention_state",
        "summary",
        "participants",
        "head_event_refs",
        "source_event_refs",
        "shared_state",
        "private_state",
        "unresolved_items"
      ],
      "properties": {
        "profile": { "const": "amos.discourse-thread-state.v1" },
        "thread_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "lifecycle": { "enum": ["open", "closed"] },
        "attention_state": {
          "enum": ["foreground", "background", "dormant"]
        },
        "summary": { "type": "string" },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "head_event_refs": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "shared_state": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/StateEntry" }
        },
        "private_state": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/StateEntry" }
        },
        "unresolved_items": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/UnresolvedItem" }
        }
      },
      "additionalProperties": false
    },
    "DiscourseSegment": {
      "type": "object",
      "required": [
        "profile",
        "summary",
        "source_event_refs",
        "generated_from_graph_version",
        "standing"
      ],
      "properties": {
        "profile": { "const": "amos.discourse-segment.v1" },
        "summary": { "type": "string" },
        "source_event_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "generated_from_graph_version": {
          "type": "integer",
          "minimum": 0
        },
        "standing": {
          "enum": [
            "testimony",
            "interpretation",
            "proposed",
            "source_summary"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
