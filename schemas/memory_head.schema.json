{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amos.local/schemas/memory_head.schema.json",
  "title": "AMOS Memory Head Request and Projection",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "profile",
        "scope",
        "series_kind",
        "series_id",
        "requester",
        "target_processor"
      ],
      "properties": {
        "profile": { "const": "amos.memory-head-request.v1" },
        "scope": { "type": "object" },
        "series_kind": {
          "enum": ["discourse_thread", "interaction_stream"]
        },
        "series_id": { "type": "string", "minLength": 1 },
        "requester": { "type": "string", "minLength": 1 },
        "target_processor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "profile",
        "series_kind",
        "series_id",
        "revision"
      ],
      "properties": {
        "status": { "enum": ["found", "absent"] },
        "profile": { "const": "amos.memory-head.v1" },
        "series_kind": {
          "enum": ["discourse_thread", "interaction_stream"]
        },
        "series_id": { "type": "string", "minLength": 1 },
        "head_ref": { "type": "string", "minLength": 1 },
        "head_version": { "type": "integer", "minimum": 1 },
        "revision": {
          "type": "object",
          "required": ["graph_version", "journal_head"],
          "properties": {
            "graph_version": { "type": "integer", "minimum": 0 },
            "journal_head": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "found" } } },
          "then": { "required": ["head_ref", "head_version"] }
        }
      ],
      "additionalProperties": false
    }
  ]
}
